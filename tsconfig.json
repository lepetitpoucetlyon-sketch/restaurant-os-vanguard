{
  "compilerOptions": {
    "target": "ES2020",
    "baseUrl": ".",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "strictFunctionTypes": false,
    "strictBindCallApply": false,
    "strictPropertyInitialization": false,
    "noImplicitThis": true,
    "useUnknownInCatchVariables": true,
    "alwaysStrict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@app/*": [
        "./src/app/*"
      ],
      "@components/*": [
        "./src/shared/components/*"
      ],
      "@/modules/intelligence": [
        "./src/modules/intelligence/index"
      ],
      "@/modules/intelligence/*": [
        "./src/modules/intelligence/*"
      ],
      "@modules/intelligence": [
        "./src/modules/intelligence/index"
      ],
      "@modules/intelligence/*": [
        "./src/modules/intelligence/*"
      ],
      "@modules/compliance": [
        "./src/modules/compliance/index"
      ],
      "@modules/compliance/*": [
        "./src/modules/compliance/*"
      ],
      "@modules/ops": [
        "./src/modules/ops/index"
      ],
      "@modules/ops/*": [
        "./src/modules/ops/*"
      ],
      "@/modules/*": [
        "./src/modules/*"
      ],
      "@modules/*": [
        "./src/modules/*"
      ],
      "@infrastructure": [
        "./src/infrastructure/index"
      ],
      "@infrastructure/*": [
        "./src/infrastructure/*"
      ],
      "@domain/schemas": [
        "./src/domain/schemas/index"
      ],
      "@domain/schemas/*": [
        "./src/domain/schemas/*"
      ],
      "@domain/types": [
        "./src/domain/types/index"
      ],
      "@domain/types/*": [
        "./src/domain/types/*"
      ],
      "@domain/*": [
        "./src/domain/*"
      ],
      "@lib/*": [
        "./src/lib/*"
      ],
      "@store/*": [
        "./src/store/*"
      ],
      "@nexus/contracts": [
        "./src/shared/nexus/contracts/index"
      ],
      "@nexus/contracts/*": [
        "./src/shared/nexus/contracts/*"
      ],
      "@nexus/*": [
        "./src/shared/nexus/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ],
      "@ui": [
        "./src/shared/components/ui/index"
      ],
      "@ui/*": [
        "./src/shared/components/ui/*"
      ],
      "@/*": [
        "./src/*"
      ],
      "@verticals/*": [
        "./src/verticals/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.mts",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-mcc/types/**/*.ts",
    ".next-mcc/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "functions",
    "graphify_tool",
    "graphify-out",
    "scratch",
    "scripts",
    "playwright-report",
    "src_VANGUARD_AUDIT",
    "src_OLD_VIBE_BACKUP",
    ".nexus/agents"
  ]
}
