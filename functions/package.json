    "argon2": "^0.44.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  }
