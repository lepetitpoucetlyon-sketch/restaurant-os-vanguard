rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Utility functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        (
          request.auth.token.admin == true ||
          request.auth.token.role == 'admin'
        );
    }

    function isManager() {
      return isSignedIn() &&
        (
          isAdmin() ||
          request.auth.token.role == 'manager'
        );
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Rules for Users collection
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || isCurrentUser(userId);
      allow delete: if isAdmin() && userId != 'user_root';
    }

    // Rules for Inventory
    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create, update: if isManager();
      allow delete: if isAdmin();
    }

    // Rules for Financial Data (Strict)
    match /financials/{docId} {
      allow read, write: if isAdmin();
    }

    // Rules for System Config
    match /systemConfig/{documentId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Rules for Audit Logs (Immutable)
    match /audit_logs/{logId} {
      allow create: if isSignedIn();
      allow read: if isManager();
      allow update, delete: if false; // No one can modify logs
    }

    // Default: Deny everything else (The "Safe" catch-all)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
