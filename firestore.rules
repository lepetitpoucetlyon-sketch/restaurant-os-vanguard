rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- 🏛️ SOVEREIGN UTILITIES ---

    function isSignedIn() {
      return request.auth != null;
    }

    function getTenantId() {
      return request.auth.token.tenantId;
    }

    function isFleetAdmin() {
      return isSignedIn() &&
             (request.auth.token.role == 'fleet_admin' || request.auth.token.role == 'SUPER_ADMIN');
    }

    function isTenantManager(tenantId) {
      return isSignedIn() &&
             getTenantId() == tenantId &&
             (request.auth.token.role == 'manager' || request.auth.token.role == 'admin');
    }

    function isTenantStaff(tenantId) {
      return isSignedIn() && getTenantId() == tenantId;
    }

    // 🔐 NF525 : collections à écriture unique — JAMAIS update/delete,
    // même pour un fleet_admin (l'immuabilité fiscale prime sur le rôle).
    // Doit rester aligné avec SovereignGuard.IMMUTABLE_COLLECTIONS (barrière client).
    function isImmutableCollection(c) {
      return c in ['journalEntries', 'fiscalSeals', 'fiscalLedger',
                   'fiscal_ledger', 'audit_logs', 'auditTrails', 'ticketZ', 'haccpLogs'];
    }

    // --- 🏛️ USERS & DEVICES CORE ---
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if isFleetAdmin();

      match /certifiedDevices/{fingerprint} {
        allow read: if isSignedIn() && request.auth.uid == userId;
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update, delete: if isFleetAdmin();
      }
    }

    // --- 🏛️ TENANT ISOLATION CORE ---
    // Toute donnée métier vit sous tenants/{tenantId}/... Le claim tenantId
    // du JWT est la SEULE source de vérité d'appartenance.

    match /tenants/{tenantId} {

      // Configuration de l'instance (lecture staff, écriture manager/MCC)
      match /tenantConfig/{docId} {
        allow read: if isTenantStaff(tenantId) || isFleetAdmin();
        allow write: if isTenantManager(tenantId) || isFleetAdmin();
      }

      // Générique : couvre orders, tables, floors, zones, products, stockItems,
      // accounts, haccp, candidates, users (sous-collection tenant), etc.
      // Les collections immuables NF525 sont write-once : create autorisé,
      // update/delete interdits pour TOUT LE MONDE.
      match /{collection}/{document=**} {
        allow read: if isTenantStaff(tenantId) || isFleetAdmin();
        allow create: if isTenantStaff(tenantId) || isFleetAdmin();
        allow update, delete: if !isImmutableCollection(collection) &&
                                 (isTenantManager(tenantId) || isFleetAdmin());
      }
    }

    // --- 🏛️ FLEET GLOBAL OVERLAY (MCC) ---

    match /fleet/{document=**} {
      allow read, write: if isFleetAdmin();
    }

    // 🛰️ Télémétrie montante : chaque instance écrit UNIQUEMENT son propre
    // document de santé ; seul le MCC (fleet_admin) lit la flotte entière.
    match /fleet-telemetry/{tenantId} {
      allow read, delete: if isFleetAdmin();
      allow create, update: if isFleetAdmin() || isTenantStaff(tenantId);
    }

    // --- 🛡️ EMERGENCY CATCH-ALL ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
