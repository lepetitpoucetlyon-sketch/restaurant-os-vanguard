rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- 🏛️ SOVEREIGN UTILITIES (Grade X+++) ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function getTenantId() {
      return request.auth.token.tenantId;
    }

    function isFleetAdmin() {
      return isSignedIn() && request.auth.token.role == 'fleet_admin';
    }

    function isTenantManager(tenantId) {
      return isSignedIn() && 
             getTenantId() == tenantId && 
             (request.auth.token.role == 'manager' || request.auth.token.role == 'admin');
    }

    function isTenantStaff(tenantId) {
      return isSignedIn() && getTenantId() == tenantId;
    }

    // --- 🏛️ TENANT ISOLATION CORE ---

    match /tenants/{tenantId} {
      
      // Configuration de l'instance (Read only pour le staff)
      match /config/{docId} {
        allow read: if isTenantStaff(tenantId) || isFleetAdmin();
        allow write: if isFleetAdmin();
      }

      // Opérations (POS, KDS, Tables)
      match /operations/{docId} {
        allow read, write: if isTenantStaff(tenantId) || isFleetAdmin();
      }

      // Inventaire & Stock
      match /inventory/{docId} {
        allow read: if isTenantStaff(tenantId) || isFleetAdmin();
        allow write: if isTenantManager(tenantId) || isFleetAdmin();
      }

      // 🔐 DONNÉES FISCALES (Grade X+++ Immutable)
      match /fiscal_ledger/{docId} {
        allow read: if isTenantManager(tenantId) || isFleetAdmin();
        allow create: if isTenantStaff(tenantId);
        allow update, delete: if false; // 🚫 NF525: Strict write-once protocol
      }

      // 🔐 AUDIT LOGS (Grade X+++ Immutable)
      match /audit_logs/{docId} {
        allow read: if isTenantManager(tenantId) || isFleetAdmin();
        allow create: if isTenantStaff(tenantId);
        allow update, delete: if false; // 🚫 NO MODIFICATION ALLOWED
      }

      // RH & Staff
      match /staff/{docId} {
        allow read, write: if isTenantManager(tenantId) || isFleetAdmin();
      }
    }

    // --- 🏛️ FLEET GLOBAL OVERLAY ---
    
    match /fleet/{docId} {
      allow read, write: if isFleetAdmin();
    }

    // --- 🛡️ EMERGENCY CATCH-ALL ---
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
