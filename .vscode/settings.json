    },
    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "[typescriptreact]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "cloudcode.project": "kitchen-os-gastro",
    "cloudcode.verbose": false,
    "cloudcode.showWelcomePage": false,
    "google.cloud.project": "kitchen-os-gastro",
    "google.gemini.projectId": "kitchen-os-gastro",
    "cloudcode.packageManager": "npm",
    "firebase.cli.path": "/Users/mohammed-aliboudjaadar/RESTAURANT-OS-CORE/node_modules/.bin/firebase",
    "typescript.tsdk": "/Users/mohammed-aliboudjaadar/RESTAURANT-OS-CORE/node_modules/typescript/lib",
    "editor.suggest.showIcons": true,
    "typescript.enablePromptUseWorkspaceTsdk": true,
    "cloudcode.asDefaultProject": true,
