    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "date-fns": "^4.1.0",
    "dexie": "^4.4.2",
    "exceljs": "^4.4.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^12.23.26",
    "jotai": "^2.19.1",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "konva": "^10.0.12",
    "lucide-react": "^0.562.0",
    "mqtt": "^5.15.2",
    "next": "^16.2.3",
    "otplib": "^13.4.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-konva": "^19.2.1",
    "resend": "^6.17.2",
    "sharp": "^0.35.3",
    "sonner": "^2.0.7",
    "stripe": "^22.3.2",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^4.3.6",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "axe-core": "^4.13.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.2",
    "oxlint": "^1.80.0",
    "playwright": "^1.59.1",
    "tailwindcss": "^4",
    "ts-morph": "^28.0.0",
    "ts-node": "^10.9.2",
    "typescript": "^5",
    "vitest": "^4.1.2"
  },
  "overrides": {
