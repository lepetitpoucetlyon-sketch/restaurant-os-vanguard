{
  "name": "restaurant-os-vanguard",
  "version": "1.0.0",
  "private": true,
  "author": "Mohammed-ali Boudjaadar",
  "copyright": "Copyright © 2026 Mohammed-ali Boudjaadar. Tous droits réservés.",
  "scripts": {
    "setup:atlas": "node .nexus/scripts/setup-atlas.js",
    "atlas": "node .nexus/scripts/atlas-wrapper.js",
    "instance:generate": "node .nexus/scripts/generate-instance-env.js",
    "instance:validate": "node .nexus/scripts/validate-instance-config.js",
    "instance:preflight": "node .nexus/scripts/preflight-instance.js",
    "instance:preflight:sample": "node .nexus/scripts/preflight-instance.js templates/client-instance.sample.json",
    "fleet:list": "node .nexus/scripts/fleet.js list",
    "fleet:switch": "node .nexus/scripts/fleet.js switch",
    "release:check": "npx eslint . --quiet && npm run instance:preflight:sample && NODE_OPTIONS='--max-old-space-size=8192' npx vitest run",
    "dev": "NODE_OPTIONS='--max-old-space-size=2048' next dev --turbo",
    "dev:mcc": "NEXT_PUBLIC_APP_MODE=mcc NODE_OPTIONS='--max-old-space-size=2048' next dev --turbo -p 3456",
    "build": "next build",
    "build:mcc": "NEXT_PUBLIC_APP_MODE=mcc next build",
    "start": "next start",
    "start:mcc": "NEXT_PUBLIC_APP_MODE=mcc next start -p 3456",
    "lint": "eslint",
    "lint:fast": "oxlint src/",
    "benchmark": "ts-node tests/benchmarks/live_performance_test.ts",
    "gitpush": "node .nexus/scripts/antigravity-push.js",
    "nexus:seal": "node .nexus/scripts/smart-seal.js",
    "nexus:deploy": "node .nexus/scripts/quick-deploy.js",
    "test": "vitest run",
    "preflight": "./scripts/preflight.sh",
    "map": "node scripts/generate-architecture-map.mjs",
    "verify:gates": "node scripts/verify-gate-integrity.mjs",
    "check:figma-guard": "node scripts/verify-figma-guardrails.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "gate:fast": "tsc --noEmit && node scripts/verify-gate-integrity.mjs && vitest run --reporter=dot",
    "measure": "node scripts/measure.mjs",
    "measure:detail": "node scripts/measure.mjs -- --detail",
    "measure:runtime": "PLAYWRIGHT_TEST_BASE_URL=http://localhost:3455 npx playwright test tests/measure --reporter=list",
    "test:e2e": "npx playwright test tests/e2e",
    "test:vanguard": "npx vitest run --config vitest.vanguard.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
